# Reproducible build environment for build_innowrap_android.sh
# ABIs: arm64-v8a, armeabi-v7a, x86, x86_64.
#
# The Android NDK r29 is baked at /opt/android-ndk-r29. The script honors
# $ANDROID_NDK_HOME and does NOT download the NDK itself. innoextract is cloned
# fresh BY THE SCRIPT on every run; only host tools live here.
#
# innowrap links NO compression library; the NDK C++ toolchain plus the
# (header-only) Boost headers (libboost-dev) are all that is needed.
#
# IMPORTANT: must be linux/amd64 -- NDK r29 is the linux-x86_64 prebuilt.
#
#   Build the image:  docker build --platform=linux/amd64 -f Dockerfile.innowrap-android -t innowrap-android .
#   Run the build:    docker run --rm --platform=linux/amd64 \
#                        -v "$PWD/out:/work/prebuilt_android_innowrap" innowrap-android
#   (output: ./out/{arm64-v8a,armeabi-v7a,x86,x86_64}/libinnowrap.so)

FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    libboost-dev \
    git \
    curl \
    ca-certificates \
    unzip \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# CMake strips -I/usr/include (it's a standard system dir), so the NDK's isolated
# sysroot never sees Boost. Expose the (header-only) Boost headers at a
# non-standard path that CMake will keep on the compile command line.
RUN mkdir -p /opt/boost-include \
 && ln -s /usr/include/boost /opt/boost-include/boost
ENV BOOST_INCLUDEDIR=/opt/boost-include

# --- Bake the Android NDK r29 (same image convention as the etc2native image) ---
ENV ANDROID_NDK_HOME=/opt/android-ndk-r29
RUN curl -fL -o /tmp/ndk.zip \
      https://dl.google.com/android/repository/android-ndk-r29-linux.zip \
 && echo "87e2bb7e9be5d6a1c6cdf5ec40dd4e0c6d07c30b  /tmp/ndk.zip" | sha1sum -c - \
 && unzip -q /tmp/ndk.zip -d /opt \
 && rm /tmp/ndk.zip \
 && test -f "$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake"

WORKDIR /work

COPY build_innowrap_android.sh /work/build_innowrap_android.sh
COPY CMakeLists.txt            /work/CMakeLists.txt
COPY wrapper/                  /work/wrapper/
RUN chmod +x /work/build_innowrap_android.sh

CMD ["sh", "/work/build_innowrap_android.sh"]
